{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB datasource (Flux) — bucket gemelo",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__elements": {},
  "__requires": [
    {"type": "grafana",    "id": "grafana",   "name": "Grafana",    "version": "10.0.0"},
    {"type": "datasource", "id": "influxdb",  "name": "InfluxDB",   "version": "1.0.0"},
    {"type": "panel",      "id": "timeseries","name": "Time series","version": ""},
    {"type": "panel",      "id": "stat",      "name": "Stat",       "version": ""}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "title": "Validación Interior — DS_INT (r = 0, z = 20.1 cm)",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "Temperatura medida por DS_INT vs temperatura estimada por el modelo en el nodo T[0, Nz//2]",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 0
          },
          "unit": "celsius",
          "min": 10,
          "max": 40
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "T_medida_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "cyan", "mode": "fixed"}},
              {"id": "displayName", "value": "T medida DS_INT [°C]"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "T_modelo_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}},
              {"id": "displayName", "value": "T modelo T[0,10] [°C]"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "T_libre_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}},
              {"id": "displayName", "value": "T modelo libre T[0,10] [°C]"},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 3]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "T_alta_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "displayName", "value": "T modelo alta α=0.80 T[0,10] [°C]"},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [2, 4]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["last", "min", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"T_medida_C\" or r._field == \"T_modelo_C\" or r._field == \"T_libre_C\" or r._field == \"T_alta_C\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "T medida vs T estimada [°C]",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "Error = T_modelo − T_medida. Umbral de validación: ±1 °C (hipótesis RMSE < 1 °C).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 15,
            "thresholdsStyle": {"mode": "line+area"}
          },
          "unit": "celsius",
          "softMin": -2,
          "softMax": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",   "value": null},
              {"color": "green", "value": -1},
              {"color": "red",   "value": 1}
            ]
          },
          "displayName": "Error [°C]"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "error_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}},
              {"id": "displayName", "value": "Error modelo (α=0.60)"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "error_alta_C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "displayName", "value": "Error alta (α=0.80)"},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [4, 4]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 1},
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max", "min"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_C\" or r._field == \"error_alta_C\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "Error T_modelo − T_medida [°C]",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "cyan"},
          "unit": "celsius",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "blue", "value": 10}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 11},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"T_medida_C\")\n  |> last()\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "title": "T medida DS_INT",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "celsius",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "orange", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 11},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"T_modelo_C\")\n  |> last()\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "title": "T estimada modelo",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "Verde = dentro del umbral ±1 °C. Rojo = fuera del umbral.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",   "value": null},
              {"color": "green", "value": -1},
              {"color": "red",   "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 11},
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_C\")\n  |> last()\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "title": "Error actual (modelo − medida)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 7,
      "title": "Métricas — Modelo con asimilación — ventana temporal seleccionada",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "MAE = promedio de |error| en la ventana temporal. Interpreta: el modelo se equivoca en promedio X °C.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",   "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 17},
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_C\")\n  |> map(fn: (r) => ({r with _value: math.abs(x: r._value)}))\n  |> mean()\n  |> yield(name: \"MAE\")",
          "refId": "A"
        }
      ],
      "title": "MAE [°C]",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "RMSE = raíz del promedio de error². Penaliza más los errores grandes. Hipótesis: RMSE < 1 °C.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",   "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 17},
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_C\")\n  |> map(fn: (r) => ({r with _value: r._value * r._value}))\n  |> mean()\n  |> map(fn: (r) => ({r with _value: math.sqrt(x: r._value)}))\n  |> yield(name: \"RMSE\")",
          "refId": "A"
        }
      ],
      "title": "RMSE [°C]",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "Número de muestras usadas para calcular MAE y RMSE en la ventana temporal seleccionada.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 17},
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_C\")\n  |> count()\n  |> yield(name: \"N\")",
          "refId": "A"
        }
      ],
      "title": "N mediciones",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 11,
      "title": "Métricas — Modelo libre (sin asimilación) — ventana temporal seleccionada",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "MAE = promedio de |error| del modelo libre (sin asimilación de datos) en la ventana temporal.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",    "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 23},
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_libre_C\")\n  |> map(fn: (r) => ({r with _value: math.abs(x: r._value)}))\n  |> mean()\n  |> yield(name: \"MAE libre\")",
          "refId": "A"
        }
      ],
      "title": "MAE libre [°C]",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "celsius",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 11},
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"gemelo\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"T_alta_C\")\n  |> last()\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "title": "T estimada modelo alta (α=0.80)",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "RMSE del modelo libre (sin asimilación de datos) en la ventana temporal. Hipótesis comparativa: RMSE libre > RMSE con asimilación.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",    "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 23},
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_libre_C\")\n  |> map(fn: (r) => ({r with _value: r._value * r._value}))\n  |> mean()\n  |> map(fn: (r) => ({r with _value: math.sqrt(x: r._value)}))\n  |> yield(name: \"RMSE libre\")",
          "refId": "A"
        }
      ],
      "title": "RMSE libre [°C]",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "id": 15,
      "title": "Métricas — Modelo alta asimilación (α=0.80) — ventana temporal seleccionada",
      "type": "row"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "MAE = promedio de |error_alta| del modelo con α=0.80 en la ventana temporal.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",    "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 29},
      "id": 16,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "import \"math\"\nfrom(bucket: \"gemelo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"validacion_interior\")\n  |> filter(fn: (r) => r._field == \"error_alta_C\")\n  |> map(fn: (r) => ({r with _value: math.abs(x: r._value)}))\n  |> mean()\n  |> yield(name: \"MAE alta\")",
          "refId": "A"
        }
      ],
      "title": "MAE alta (α=0.80) [°C]",
      "type": "stat"
    },

    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "description": "RMSE del modelo con alta asimilación (α=0.80) en la ventana temporal. Comparar con RMSE del modelo nominal (α=0.60).",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",    "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 29},
      "id": 17,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
